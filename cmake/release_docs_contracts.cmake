cmake_minimum_required(VERSION 3.20)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${source}/CMakeLists.txt" project_text)
string(REGEX MATCH "project\\(ToolX VERSION ([0-9]+[.][0-9]+[.][0-9]+)" project_version "${project_text}")
if(NOT project_version)
    message(FATAL_ERROR "Cannot determine the real ToolX project version")
endif()
set(version "${CMAKE_MATCH_1}")
set(tag "v${version}")
set(note "docs/releases/${tag}.md")
set(root "${CMAKE_CURRENT_BINARY_DIR}/release-docs-fixture")
get_filename_component(root "${root}" ABSOLUTE)
# Reset only this test's fixture, including mutations from an interrupted run.
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")

function(check tree docs_expected release_expected label docs_diagnostic release_diagnostic)
    foreach(mode IN ITEMS docs release)
        if(mode STREQUAL "docs")
            set(script docs_check.cmake)
            set(expected "${docs_expected}")
            set(diagnostic "${docs_diagnostic}")
        else()
            set(script release_preflight.cmake)
            set(expected "${release_expected}")
            set(diagnostic "${release_diagnostic}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DTOOLX_REPOSITORY_ROOT=${tree}"
            "-DTOOLX_SOURCE_ROOT=${tree}" "-DTOOLX_RELEASE_TAG=${tag}"
            -P "${CMAKE_CURRENT_LIST_DIR}/${script}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(expected AND NOT result EQUAL 0 OR NOT expected AND result EQUAL 0)
            message(FATAL_ERROR "${label}: unexpected ${mode} check result: ${result} ${output} ${error}")
        endif()
        if(NOT expected)
            if(diagnostic STREQUAL "")
                message(FATAL_ERROR "${label}: missing expected ${mode} rejection diagnostic")
            endif()
            # Match the intended rejection despite diagnostic line wrapping.
            string(REGEX REPLACE "[ \t\r\n]+" " " actual "${output}${error}")
            string(REGEX REPLACE "[ \t\r\n]+" " " wanted "${diagnostic}")
            string(FIND "${actual}" "${wanted}" found)
            if(found EQUAL -1)
                message(FATAL_ERROR "${label}: wrong ${mode} rejection; expected ${diagnostic}, got ${output}${error}")
            endif()
        endif()
    endforeach()
endfunction()

# Check the actual tree before constructing the isolated fixture. Candidate
# documents are valid for development and must remain invalid for publication.
if(NOT EXISTS "${source}/${note}")
    message(FATAL_ERROR "Missing current release note in actual tree: ${note}")
endif()
file(READ "${source}/${note}" actual_notes)
if(actual_notes MATCHES "(^|[\r\n])> Status: Candidate; not yet tagged([\r\n]|$)")
    if(actual_notes MATCHES "^# ToolX ${tag}([\r\n]|$)")
        # Candidate metadata includes a semicolon; either the count or value
        # branch of the unchanged formal checker may reject this Status field.
        set(candidate_diagnostic "> Status: Released")
    else()
        set(candidate_diagnostic "Release note heading does not match the tag")
    endif()
    check("${source}" TRUE FALSE "actual candidate tree" "" "${candidate_diagnostic}")
    message(STATUS "Actual ${tag} candidate passes docs-check and is rejected by formal release preflight")
elseif(actual_notes MATCHES "(^|[\r\n])> Status: Released([\r\n]|$)")
    check("${source}" TRUE TRUE "actual released tree" "" "")
else()
    message(FATAL_ERROR "Current release note must explicitly identify the actual candidate or released state")
endif()

foreach(item IN ITEMS docs examples experiments include src tools tests cmake .github README.md README.dev.md CHANGELOG.md CMakeLists.txt CMakePresets.json LICENSE)
    file(COPY "${source}/${item}" DESTINATION "${root}" PATTERN "__pycache__" EXCLUDE)
endforeach()
# Derive fixture versions from the copied project and construct complete current
# documents without depending on wording in the real README or changelog.
set(candidate_notes "# ToolX ${tag} Release Candidate\n\n> Audience: ToolX users and release reviewers\n> Status: Candidate; not yet tagged\n> Applies to: ${tag}\n> Source of truth for: candidate release narrative\n\n## Highlights\n\nProposed fixes.\n\n## Compatibility\n\nNo API changes.\n\n## Build and dependency impact\n\nNo new dependencies.\n\n## Migration\n\nNone.\n\n## Known limitations\n\nNot yet tagged.\n")
file(WRITE "${root}/${note}" "${candidate_notes}")
file(WRITE "${root}/README.md" "# ToolX ${tag}\n\n> Status: Candidate; not yet tagged\n> Applies to: ${tag}\n\nThis snapshot is the ${tag} release candidate.\n")
file(WRITE "${root}/CHANGELOG.md" "# Changelog\n\n## [Unreleased]\n\nTarget: `${tag}` release candidate\n")
check("${root}" TRUE FALSE "complete isolated candidate" "" "Release note heading does not match the tag")

set(released_readme "# ToolX ${tag}\n\n> Status: Released\n> Applies to: ${tag}\n> Latest release: ${tag}\n\nPublished fixes.\n")
set(released_changelog "# Changelog\n\n> Status: Released\n> Applies to: ${tag}\n\n## [${version}] - 2026-10-19\n\nPublished fixes.\n\n## [0.0.0]\n\nThe previous release replaced an unreleased candidate.\n")
set(released_notes "# ToolX ${tag}\n\n> Audience: ToolX users and release reviewers\n> Status: Released\n> Applies to: ${tag}\n> Source of truth for: release narrative\n\n## Highlights\n\nPublished fixes.\n\n## Compatibility\n\nNo API changes.\n\n## Build and dependency impact\n\nNo new dependencies.\n\n## Migration\n\nNone.\n\n## Known limitations\n\nSee module documentation.\n")
file(WRITE "${root}/README.md" "${released_readme}")
file(WRITE "${root}/CHANGELOG.md" "${released_changelog}")
file(WRITE "${root}/${note}" "${released_notes}")
check("${root}" TRUE TRUE "complete isolated released state with historical candidate text" "" "")

function(reject_change file text label release_diagnostic)
    set(docs_diagnostic "${release_diagnostic}")
    if(ARGC GREATER 4)
        set(docs_diagnostic "${ARGV4}")
    endif()
    file(READ "${root}/${file}" saved)
    file(WRITE "${root}/${file}" "${text}")
    check("${root}" FALSE FALSE "${file}: ${label}" "${docs_diagnostic}" "${release_diagnostic}")
    file(WRITE "${root}/${file}" "${saved}")
endfunction()

# Mutations must fail both entry points for the intended field/status reason;
# an unrelated early tag/version mismatch must never satisfy these tests.
foreach(file IN ITEMS README.md CHANGELOG.md "${note}")
    file(READ "${root}/${file}" valid)
    foreach(residue IN ITEMS
            "Target: `${tag}` release candidate"
            "candidate release narrative"
            "This note remains a candidate document"
            "This is a RELEASE-CANDIDATE"
            "This release is Unreleased"
            "Not yet tagged"
            "The latest tagged release remains `v0.0.0`.")
        string(REPLACE "> Status: Released" "> Status: Released\n${residue}" invalid "${valid}")
        reject_change("${file}" "${invalid}" "residual status: ${residue}"
            "residual candidate or stale release-state prose")
    endforeach()
    foreach(field IN ITEMS Status "Applies to")
        string(REGEX REPLACE "> ${field}:[^\n]*\n" "" invalid "${valid}")
        if(file STREQUAL note AND field STREQUAL "Status")
            set(docs_status_diagnostic "must declare Candidate")
        else()
            set(docs_status_diagnostic "expected exactly one > ${field}:")
        endif()
        reject_change("${file}" "${invalid}" "missing ${field}"
            "expected exactly one > ${field}:" "${docs_status_diagnostic}")
        string(REPLACE "> ${field}:" "> ${field}: Wrong\n> ${field}:" invalid "${valid}")
        reject_change("${file}" "${invalid}" "duplicate conflicting ${field}"
            "expected exactly one > ${field}:" "${docs_status_diagnostic}")
    endforeach()
    string(REPLACE "> Applies to: ${tag}" "> Applies to: ${tag}0" invalid "${valid}")
    reject_change("${file}" "${invalid}" "near-match version" "expected > Applies to: ${tag}")
endforeach()
string(REPLACE "> Latest release: ${tag}" "> Latest release: v0.0.0" invalid "${released_readme}")
reject_change(README.md "${invalid}" "stale latest release" "expected > Latest release: ${tag}")
string(REPLACE "release narrative" "candidate release narrative" invalid "${released_notes}")
reject_change("${note}" "${invalid}" "candidate narrative metadata" "residual candidate or stale release-state prose")
string(REPLACE "> Status: Released" "> Status: Unknown" invalid "${released_notes}")
reject_change("${note}" "${invalid}" "unknown status" "expected > Status: Released"
    "must declare Candidate")
string(REPLACE "## [${version}] - 2026-10-19" "## [Unreleased]\n\n## [${version}] - 2026-10-19" invalid "${released_changelog}")
reject_change(CHANGELOG.md "${invalid}" "unreleased section before current release" "CHANGELOG.md: first entry must be")
string(REPLACE "Published fixes." "Target: `${tag}` release candidate" invalid "${released_changelog}")
reject_change(CHANGELOG.md "${invalid}" "candidate target inside current section" "residual candidate or stale release-state prose")
foreach(file_field IN ITEMS "README.md|Latest release" "${note}|Source of truth for")
    string(REPLACE "|" ";" pair "${file_field}")
    list(GET pair 0 file)
    list(GET pair 1 field)
    file(READ "${root}/${file}" valid)
    string(REGEX REPLACE "> ${field}:[^\n]*\n" "" invalid "${valid}")
    reject_change("${file}" "${invalid}" "missing ${field}" "expected exactly one > ${field}:")
    string(REPLACE "> ${field}:" "> ${field}: Wrong\n> ${field}:" invalid "${valid}")
    reject_change("${file}" "${invalid}" "duplicate ${field}" "expected exactly one > ${field}:")
endforeach()
foreach(heading IN ITEMS "## [${version}]" "## [Unreleased]" "## Hidden current status")
    string(REPLACE "## [0.0.0]" "${heading}" invalid "${released_changelog}")
    if(heading STREQUAL "## [${version}]")
        set(diagnostic "duplicate current or future release entry")
    else()
        set(diagnostic "later H2 headings must identify older releases")
    endif()
    reject_change(CHANGELOG.md "${invalid}" "invalid historical boundary: ${heading}" "${diagnostic}")
endforeach()
check("${root}" TRUE TRUE "restored isolated released state" "" "")
message(STATUS "Release docs contracts passed for ${tag}: actual state, isolated transitions, and diagnostic-checked negatives")
